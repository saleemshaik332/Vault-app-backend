# Copy this file to .env and fill in real values. Never commit the real .env file.

DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: If you lose this key, all encrypted data becomes permanently unreadable.
# Back it up somewhere safe and separate from the database itself.
ENCRYPTION_KEY=paste-a-generated-fernet-key-here

# MongoDB connection (used only by the password vault feature)
# Local install:      mongodb://localhost:27017
# MongoDB Atlas (free tier): mongodb+srv://<user>:<password>@<cluster-url>/
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=vault_credentials

# Origins allowed to call this API (your frontend's URL)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500
